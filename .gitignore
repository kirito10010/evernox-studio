# ============================================================
# 哪些东西不进 GitHub —— 别删这里的规则，删了密钥/数据就会上传
# 重装系统的完整恢复步骤见「使用手册.md」第 5 节
# ============================================================

# ===== 敏感文件：绝对不能提交（重装后从 U 盘恢复）=====
evernox-backend/config/application.yml
/jwt-keys/

# 通用密钥类文件兜底，防止以后新增的密钥文件被误提交
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.env

# ===== 运行时数据：用户上传的图片（体积大且是用户数据，单独备份）=====
evernox-backend/data/

# ===== 构建产物与依赖（重装后重新构建即可）=====
evernox-backend/target/
evernox-frontend/node_modules/
evernox-frontend/dist/

# ===== 前端锁文件：本项目统一用 npm，pnpm 产物一律不入库 =====
evernox-frontend/pnpm-lock.yaml
evernox-frontend/pnpm-workspace.yaml

# ===== Nginx 二进制发行包（从官网重下）=====
# 只把**服务器那一份** nginx.conf 纳入版本管理（重装后拉代码就有部署配置）。
#
# 为什么钉死目录名 nginx-1.30.4 而不用通配：
#   服务器上的目录就叫 nginx-1.30.4（切换端口*.bat 里也写死了这个名字），
#   而本地可能并存别的版本（如 nginx-1.30.5）。若用通配 /nginx-*/conf/nginx.conf，
#   两份 nginx.conf 会同时变成可提交 —— 提交错一份，服务器恢复时就拿到错配置。
#   所以只放行服务器这一份，其余 nginx-* 目录整份忽略。
#
# 注意：必须写 /nginx-*/*（排除目录内容），不能写 /nginx-*/（排除目录本身），
#       否则下面 ! 开头的重新包含规则会失效
/nginx-*/*
!/nginx-*/conf/
/nginx-*/conf/*
!/nginx-1.30.4/conf/nginx.conf

# ===== Redis 二进制发行包（从官网重下；dump.rdb 是缓存快照，丢了无影响）=====
# 用 /Redis*/ 而不是 /Redis-*/：服务器上的目录就叫 Redis（没有版本号后缀），
# 写 /Redis-*/ 会匹配不上 → redis-server.exe / dump.rdb 变成可提交。
/Redis*/

# ===== Comate 本地规格文档（AI 生成的设计文档，不是运行所需）=====
/.comate/

# ===== IDE / 操作系统 =====
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# ===== 日志与临时产物 =====
*.log
arena-lb-*.zip
