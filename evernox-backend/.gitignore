jwt-keys/

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# IDE（通用项 .idea/、*.iml、.vscode/ 由根目录 .gitignore 统一覆盖）
